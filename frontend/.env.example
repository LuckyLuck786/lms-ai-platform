# ------------------------------------------------------------------
# Frontend (Vite) environment template.
#
# Only variables prefixed with VITE_ reach the browser bundle — never put a
# secret in this file.
# ------------------------------------------------------------------

# Base URL of the LMS API. Leave unset locally: `npm run dev` proxies
# /api to http://localhost:4000 (see vite.config.ts).
# Set it to an absolute URL in production, e.g.
#   VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_API_BASE_URL=

# Demo mode. When no absolute VITE_API_BASE_URL is set, production builds
# answer API calls from the in-browser sample backend in src/services/demo/
# and `npm run dev` talks to the real API through the dev proxy.
#
#   VITE_DEMO_MODE=true   always use the in-browser demo backend
#   VITE_DEMO_MODE=false  always call the real API
#
# ?demo=on / ?demo=off in the URL overrides this at runtime.
VITE_DEMO_MODE=