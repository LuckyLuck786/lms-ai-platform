# ------------------------------------------------------------------
# LMS-AI Platform — environment template
# Copy to .env and fill in real values. Every service reads from this
# file (docker-compose interpolates it, backend/ai-service load it).
# ------------------------------------------------------------------

# --- Core LMS service (backend/) ---
NODE_ENV=development
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL 15 + pgvector
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev_password
POSTGRES_DB=lms
POSTGRES_PORT=5432
# Used by the backend when running outside Docker:
DATABASE_URL=postgresql://lms:lms_dev_password@localhost:5432/lms
# Used by docker-compose services (internal network):
DATABASE_URL_INTERNAL=postgresql://lms:lms_dev_password@postgres:5432/lms

# Redis (cache + BullMQ queues)
REDIS_URL=redis://localhost:6379
REDIS_URL_INTERNAL=redis://redis:6379

# JWT — generate strong secrets in production!
JWT_SECRET=dev-only-change-me-jwt-secret-32-chars-min
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- AI service (ai-service/) ---
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# LLM providers — auto-detected in priority order: Groq → Gemini → Anthropic.
# Set whichever keys you have; leave the rest blank.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Embeddings use Gemini text-embedding-004 when GEMINI_API_KEY is set,
# otherwise a deterministic local encoder (fine for demos).
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=1536

# --- Object storage (MinIO locally / S3 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT_INTERNAL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lms-media
S3_FORCE_PATH_STYLE=true

# --- Frontend (frontend/) — Vite only exposes VITE_* vars ---
VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- Notifications ---
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=no-reply@vertexon.example
