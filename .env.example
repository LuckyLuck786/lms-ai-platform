# ------------------------------------------------------------------
# LMS-AI Platform — environment template
# Copy to .env and fill in real values. Every service reads from this
# file (docker-compose interpolates it, backend/ai-service load it).
# ------------------------------------------------------------------

# --- Core LMS service (backend/) ---
NODE_ENV=development
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL 15 + pgvector
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev_password
POSTGRES_DB=lms
POSTGRES_PORT=5432
# Used by the backend when running outside Docker:
DATABASE_URL=postgresql://lms:lms_dev_password@localhost:5432/lms
# Used by docker-compose services (internal network):
DATABASE_URL_INTERNAL=postgresql://lms:lms_dev_password@postgres:5432/lms

# Redis (cache + BullMQ queues)
REDIS_URL=redis://localhost:6379
REDIS_URL_INTERNAL=redis://redis:6379

# JWT — generate strong secrets in production!
# The backend REFUSES to start in NODE_ENV=production when these are unset or
# still set to the placeholders below: a public signing key means every access
# token is forgeable by anyone who has read this file. Generate real values with
#   openssl rand -base64 48
JWT_SECRET=dev-only-change-me-jwt-secret-32-chars-min
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Shared secret the backend presents to the AI service (header
# X-Internal-Token). The AI service rejects internal routes without it when
# set; leave blank in development to keep local calls effortless, but always
# set it in production — the ingest route writes to the RAG corpus.
INTERNAL_API_TOKEN=

# --- AI service (ai-service/) ---
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# Absolute origin of this API. The AI service runs as a separate process, so it
# cannot resolve a backend-relative `/uploads/...` path; the transcription job
# builds an absolute media URL from this. Defaults to http://localhost:<port>.
PUBLIC_API_URL=http://localhost:4000

# LLM providers — auto-detected in priority order: Groq → Gemini → Anthropic.
# Set whichever keys you have; leave the rest blank.
#
# GROQ_API_KEY also powers speech-to-text: a lecture uploaded with a video and
# no transcript is queued for transcription, and only runs when this is set.
#   Groq models a free-tier key can serve: openai/gpt-oss-120b, openai/gpt-oss-20b,
#     qwen/qwen3.8-27b, allam-2-7b
#     (llama-3.3-70b-versatile is no longer offered on newer accounts)
#   Gemini models: gemini-2.5-flash, gemini-flash-latest, gemini-2.5-pro
#     (gemini-2.0-flash is retired)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Embeddings use Gemini when GEMINI_API_KEY is set, otherwise a
# deterministic local encoder (fine for demos).
# text-embedding-004 is retired; gemini-embedding-001 is requested at
# 1536 dims to match document_chunks.embedding VECTOR(1536).
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# Speech-to-text (PRD §9.3). The provider caps audio uploads at ~25 MB; larger
# videos are reduced to a mono audio track with ffmpeg first, which the
# ai-service image installs.
STT_MODEL=whisper-large-v3-turbo
STT_MAX_BYTES=26214400

# --- Uploaded media (durable across redeploys) ---
# Set GCS_BUCKET to keep lecture material, assignment files and generated
# certificate PDFs in Google Cloud Storage (using the runtime service
# account's Application Default Credentials). Leave blank to write to local
# disk under ./uploads, which is fine for development but is wiped on every
# Cloud Run redeploy.
GCS_BUCKET=

# S3/MinIO is the local docker-compose profile only; that driver is not
# implemented, so these settings do not affect production.
S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT_INTERNAL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lms-media
S3_FORCE_PATH_STYLE=true

# --- Payments (Razorpay) ---
# Paid courses are gated behind checkout. With no keys configured the checkout
# routes return 503 and free courses are completely unaffected, so this is
# optional for a content-only deployment.
#   * RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET are the API key pair.
#   * RAZORPAY_WEBHOOK_SECRET is the *webhook* secret from the dashboard, which
#     is a different value — it verifies the HMAC on incoming callbacks.
# Point the dashboard webhook at
#   https://<api-host>/api/v1/courses/<course_id>/payment/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Frontend (frontend/) — Vite only exposes VITE_* vars ---
VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- Notifications ---
# Mailpit ships in docker-compose: SMTP on 1025, web inbox on
# http://localhost:8025. Production should point SMTP_URL at a real provider
# (e.g. smtps://user:pass@smtp.resend.com:465) — same code path.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=no-reply@vertexon.example
EMAIL_FROM_NAME=Vertexon LMS-AI
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Base URL used for deep links inside transactional email.
APP_URL=http://localhost:5173
